{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sensend",
  "version": "0.5.4",
  "identifier": "com.jloft.sensend",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sensend",
        "width": 420,
        "height": 210,
        "minWidth": 280,
        "minHeight": 200,
        "resizable": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true,
        "visible": false,
        "visibleOnAllWorkspaces": true,
        "backgroundColor": "#ffffff"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'self'; frame-src 'self'"
    }
  },
"bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc4Mjk2RTE4QzE1M0U4MDYKUldRRzZGUEJHRzRwZUR5L2tMTFZWRm1wakNYOENpbXRMR2VOV0Y4cjVpKzhEQ2hqcUV4OFJuR3gK",
      "endpoints": [
        "https://github.com/jloft198479-cyber/sensend/releases/latest/download/latest.json",
        "https://cnb.cool/fzz198479/sensend/-/releases/download/latest/latest.json"
      ]
    }
  }
}